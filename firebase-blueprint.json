{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Represents a Spotpix user profile synced with Firebase Auth / Gmail Sign-In.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The authenticated Firebase UID owning this profile."
        },
        "username": {
          "type": "string",
          "description": "Unique Spotpix handle."
        },
        "displayName": {
          "type": "string",
          "description": "Display name shown on profile."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Gmail address."
        },
        "bio": {
          "type": "string",
          "description": "User bio text."
        },
        "avatarUrl": {
          "type": "string",
          "description": "Avatar photo URL."
        },
        "role": {
          "type": "string",
          "enum": ["USER", "CREATOR", "SUPER_ADMIN"],
          "description": "Access role."
        },
        "blueTickVerified": {
          "type": "boolean",
          "description": "Whether approved for VETA Blue Tick."
        },
        "isMonetized": {
          "type": "boolean",
          "description": "Whether approved for Creator Monetization."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated."
        }
      },
      "required": [
        "userId",
        "username",
        "displayName",
        "email",
        "bio",
        "avatarUrl",
        "role",
        "blueTickVerified",
        "isMonetized",
        "createdAt"
      ]
    },
    "SpotpixPost": {
      "title": "SpotpixPost",
      "description": "Represents a Spotpix feed post, reel, or story item.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of the author."
        },
        "authorUsername": {
          "type": "string",
          "description": "Username of the author."
        },
        "caption": {
          "type": "string",
          "description": "Post caption text."
        },
        "mediaUrl": {
          "type": "string",
          "description": "Media image or video URL."
        },
        "mediaType": {
          "type": "string",
          "enum": ["POST", "REEL", "STORY"],
          "description": "Content format."
        },
        "likesCount": {
          "type": "integer",
          "description": "Total likes count."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated."
        }
      },
      "required": [
        "userId",
        "authorUsername",
        "caption",
        "mediaUrl",
        "mediaType",
        "likesCount",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores Spotpix user profiles keyed by Firebase Auth UID."
    },
    "/posts/{postId}": {
      "schema": {
        "$ref": "#/entities/SpotpixPost"
      },
      "description": "Stores Spotpix posts, reels, and stories."
    }
  }
}
